# MongoDB connection
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/event-app

# JWT secret for auth tokens
JWT_SECRET=your-secret-key

# Server port
PORT=5000

# Supabase for real-time features (create project at https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
# Service role key (found in Supabase Settings > API > service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary for image uploads (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack secret key for webhook verification (https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Resend for transactional emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Email sender address (must be verified in Resend)
EMAIL_FROM=reminders@yourdomain.com

# Google Maps API key (optional — for static map images in reminder emails)
GOOGLE_MAPS_API_KEY=AIza...

# Google OAuth client ID (optional — for Google Sign-In)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Client URL (for password reset links)
CLIENT_URL=http://localhost:5173
